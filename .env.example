# --- ListenBrainz (the recommendation brain; free) -----------------------------------------
DD_LB_USER=your_listenbrainz_username
DD_LB_TOKEN=                      # user token: lets DailyDig send like/dislike feedback and forward scrobbles

# --- Navidrome ------------------------------------------------------------------------------
DD_NAVIDROME_URL=http://192.168.68.11:4533
DD_NAVIDROME_USER=
DD_NAVIDROME_PASS=

# =============================== DOWNLOADER ===================================================
# auto | yubal_cli | yubal_api | ytdlp
#   auto = yubal_cli if DD_YUBAL_CMD is set, else yubal_api if DD_YUBAL_URL is set, else ytdlp
DD_DOWNLOADER=auto

# --- Option 1: yubal CLI (keeps every yubal feature: lyrics, ReplayGain, formats, dedup) -------
# Runs without a shell. {url} and {dest} are substituted. Your LXC-over-ssh setup:
#   DD_YUBAL_CMD=ssh -o BatchMode=yes -i /config/ssh/id_ed25519 root@PROXMOX_IP pct exec 100 -- /usr/local/bin/yubal download {url} {dest}
# (mount a key into /config/ssh and authorize it on the Proxmox host)
DD_YUBAL_CMD=
DD_YUBAL_DEST=/app/data                # destination as yubal sees it = your library root
DD_YUBAL_PATH_MAP=/app/data=/music     # yubal path prefix = path of the same folder in THIS container
DD_DL_CONCURRENCY=3                    # parallel downloads; hides the slow ssh/pct startup

# --- Option 2: yubal web API (endpoint discovered from yubal's /openapi.json) -------------------
DD_YUBAL_URL=
DD_YUBAL_DATA_DIR=                     # yubal's library folder as seen from this container

# --- Option 3: native yt-dlp (no yubal needed) ------------------------------------------------------
DD_AUDIO_FORMAT=opus                   # opus | mp3 | m4a
DD_AUDIO_QUALITY=0                     # 0 best .. 10 worst (transcodes only)
# Where files go inside your library. Default matches yubal's own layout.
# Tokens: {artist} {album_artist} {album} {year} {track} {title} {ext}   e.g. {track:02d}
DD_PATH_TEMPLATE={album_artist}/{year} - {album}/{track:02d} - {title}.{ext}
DD_FETCH_LYRICS=1                      # synced .lrc from lrclib.net
DD_REPLAYGAIN=1
DD_ASCII_FILENAMES=0

# --- Behaviour --------------------------------------------------------------------------------
DD_REGION=us
# Downloads go straight into your library by default. To stage them in a subfolder instead, so unstarred
# tracks can auto-expire and starred ones get promoted into the library, set both:
DD_DISCOVERY_SUBDIR=              # e.g. _discovery  (empty = library root)
DD_EXPIRE_DAYS=0                  # only used with a subfolder; 0 = keep forever
DD_PLAYLISTS_SUBDIR=_Playlists    # where the .m3u8 files are written
DD_AUTO_DOWNLOAD=1
DD_WORKERS=4
DD_CONTACT=you@example.com        # goes in the MusicBrainz User-Agent (they ask for a real contact)

# --- Security (optional) -------------------------------------------------------------------
DD_ADMIN_PASSWORD=                # HTTP Basic password for the web UI (any username)
DD_INGEST_TOKEN=                  # token Navidrome uses when scrobbling to DailyDig
